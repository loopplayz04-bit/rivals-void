-- ============================================================
-- AIM PREDICTION
-- ============================================================
local lastPos = {}

local function getVelocity(player)
    local c = player.Character
    if not c then return Vector3.zero end
    local r = c:FindFirstChild("HumanoidRootPart")
    if not r then return Vector3.zero end
    
    local now = tick()
    local uid = player.UserId
    local prev = lastPos[uid]
    lastPos[uid] = { pos = r.Position, t = now }
    
    if prev and (now - prev.t) > 0 then
        return (r.Position - prev.pos) / (now - prev.t)
    end
    return Vector3.zero
end

local function getPredicted(player)
    local c = player.Character
    if not c then return nil end
    local part = c:FindFirstChild(CFG.AimPart)
    if not part then return nil end
    
    local vel  = getVelocity(player)
    local dist = (part.Position - Camera.CFrame.Position).Magnitude
    local travelTime = dist / 350
    return part.Position + vel * travelTime * CFG.Prediction * 10
end

-- ============================================================
-- AIMBOT
-- ============================================================
local function getBestTarget()
    local best, bestDist = nil, math.huge
    local center = Camera.ViewportSize / 2
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then 
        elseif isAlive(p) then
            local c    = p.Character
            local part = c and c:FindFirstChild(CFG.AimPart)
            if part then
                local predicted = getPredicted(p) or part.Position
                local sp, onScreen = Camera:WorldToViewportPoint(predicted)
                local screenPos = Vector2.new(sp.X, sp.Y)
                
                if onScreen then
                    local d = (screenPos - center).Magnitude
                    if d <= CFG.FOVRadius then
                        if CFG.WallCheck then
                            local params = RaycastParams.new()
                            params.FilterDescendantsInstances = { LocalPlayer.Character, c }
                            params.FilterType = Enum.RaycastFilterType.Exclude
                            local ray = workspace:Raycast(Camera.CFrame.Position, part.Position - Camera.CFrame.Position, params)
                            if ray and not ray.Instance:IsDescendantOf(c) then
                                -- blocked
                            elseif d < bestDist then 
                                bestDist = d 
                                best = p 
                            end
                        elseif d < bestDist then 
                            bestDist = d 
                            best = p 
                        end
                    end
                end
            end
        end
    end
    return best
end

local VIM = game:GetService("VirtualInputManager")

local function isFirstPerson()
    local char = getChar()
    if not char then return false end
    local head = char:FindFirstChild("Head")
    if not head then return false end
    return (Camera.CFrame.Position - head.Position).Magnitude < 2
end

local function moveCamera(targetScreenPos)
    local center = Camera.ViewportSize / 2
    local delta  = targetScreenPos - center
    local speed = math.clamp(CFG.Smoothing * 2, 0.05, 1.0)
    local move  = delta * speed
    local maxPx = 80
    if move.Magnitude > maxPx then
        move = move.Unit * maxPx
    end
    if move.Magnitude < 0.5 then return end
    
    if mousemoverel then
        pcall(mousemoverel, move.X, move.Y)
        return
    end
    
    pcall(function()
        VIM:SendMouseMoveEvent(math.floor(center.X + move.X),
                               math.floor(center.Y + move.Y),
                               workspace)
    end)
    
    if not isFirstPerson() then
        local cur = Camera.CFrame
        local predicted3d = Camera:ScreenPointToRay(center.X + move.X,
                                                     center.Y + move.Y).Direction
        Camera.CFrame = CFrame.new(cur.Position, cur.Position + predicted3d * 100)
    end
end

RunService.RenderStepped:Connect(function()
    if not CFG.AimbotEnabled then return end
    
    local holding = CFG.AimOnClick
        and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
        or  UserInputService:IsKeyDown(CFG.AimKey)
    
    if not holding then return end
    
    local target = getBestTarget()
    if not target then return end
    
    local predicted = getPredicted(target)
    if not predicted then return end
    
    local sp, onScreen = Camera:WorldToViewportPoint(predicted)
    if not onScreen then return end
    
    moveCamera(Vector2.new(sp.X, sp.Y))
end)

