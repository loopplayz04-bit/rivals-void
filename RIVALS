local function hideWindow()
    TweenService:Create(Win, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 360, 0, 0),
        BackgroundTransparency = 1,
    }):Play()
    TweenService:Create(Shadow, TweenInfo.new(0.25), { ImageTransparency = 1 }):Play()
    task.wait(0.35)
    Win.Visible    = false
    Shadow.Visible = false
    Win.Size = UDim2.new(0, 360, 0, 540)
    Win.BackgroundTransparency = 0
end

local function showWindow()
    Win.Visible    = true
    Shadow.Visible = true
    Shadow.ImageTransparency = 1
    Win.Size = UDim2.new(0, 360, 0, 0)
    Win.BackgroundTransparency = 1
    TweenService:Create(Win, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 360, 0, 540),
        BackgroundTransparency = 0,
    }):Play()
    TweenService:Create(Shadow, TweenInfo.new(0.4), { ImageTransparency = 0.5 }):Play()
    TIconLbl.Rotation = -90
    TweenService:Create(TIconLbl, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Rotation = 0
    }):Play()
end

CloseBtn.MouseButton1Click:Connect(function()
    task.spawn(hideWindow)
end)

local minimized = false
MinBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    local targetH = minimized and 54 or 540
    TweenService:Create(Win, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 360, 0, targetH)
    }):Play()
    
    if minimized then
        TweenService:Create(Shadow, TweenInfo.new(0.2), { ImageTransparency = 1 }):Play()
    else
        TweenService:Create(Shadow, TweenInfo.new(0.3), { ImageTransparency = 0.5 }):Play()
    end
    MinBtn.Text = minimized and "+" or "–"
end)

UserInputService.InputBegan:Connect(function(i, gpe)
    if not gpe and i.KeyCode == Enum.KeyCode.RightShift then
        if Win.Visible then
            task.spawn(hideWindow)
        else
            showWindow()
        end
    end
end)

-- Open animation
Shadow.Visible = false
Shadow.ImageTransparency = 1
Win.Size = UDim2.new(0, 360, 0, 0)
Win.BackgroundTransparency = 1

TweenService:Create(Win, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
    Size = UDim2.new(0, 360, 0, 540),
    BackgroundTransparency = 0,
}):Play()

task.delay(0.1, function()
    Shadow.Visible = true
    TweenService:Create(Shadow, TweenInfo.new(0.4), { ImageTransparency = 0.5 }):Play()
end)

-- Icon spin on open
TIconLbl.Rotation = -180
TweenService:Create(TIconLbl, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
    Rotation = 0
}):Play()

