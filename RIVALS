    Knob.BackgroundColor3 = C.white
    Knob.BorderSizePixel = 0
    Knob.Parent = Bg
    
    Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)
    
    local KS = Instance.new("UIStroke", Knob)
    KS.Color = Color3.fromRGB(0,0,0)
    KS.Transparency = 0.7
    KS.Thickness = 1
    
    local state = default
    local ti = TweenInfo.new(0.18, Enum.EasingStyle.Quad)
    
    local HitBtn = Instance.new("TextButton")
    HitBtn.Size = UDim2.new(1, 0, 1, 0)
    HitBtn.BackgroundTransparency = 1
    HitBtn.Text = ""
    HitBtn.Parent = Row
    
    HitBtn.MouseButton1Click:Connect(function()
        state = not state
        
        TweenService:Create(Knob, TweenInfo.new(0.08, Enum.EasingStyle.Quad), {
            Size = UDim2.new(0, 22, 0, 22)
        }):Play()
        task.delay(0.08, function()
            TweenService:Create(Knob, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 17, 0, 17)
            }):Play()
        end)
        
        TweenService:Create(Row, TweenInfo.new(0.08), {
            BackgroundColor3 = state and Color3.fromRGB(30, 28, 50) or Color3.fromRGB(35, 20, 20)
        }):Play()
        task.delay(0.15, function()
            TweenService:Create(Row, TweenInfo.new(0.2), { BackgroundColor3 = C.row }):Play()
        end)
        
        TweenService:Create(Bg, ti, { BackgroundColor3 = state and C.accent1 or C.subtle }):Play()
        TweenService:Create(Knob, ti, { 
            Position = state and UDim2.new(1,-20,0.5,-8) or UDim2.new(0,3,0.5,-8) 
        }):Play()
        
        cb(state)
    end)
    
    HitBtn.MouseEnter:Connect(function()
        TweenService:Create(Row, TweenInfo.new(0.1), { BackgroundColor3 = Color3.fromRGB(25,25,36) }):Play()
    end)
    
    HitBtn.MouseLeave:Connect(function()
        TweenService:Create(Row, TweenInfo.new(0.1), { BackgroundColor3 = C.row }):Play()
    end)
end

local function Slider(parent, label, minV, maxV, default, cb)
    local Row = Instance.new("Frame")
