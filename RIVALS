local function shakeCard()
    local orig = KCard.Position
    for i = 1, 5 do
        TweenService:Create(KCard, TweenInfo.new(0.04), 
            {Position = UDim2.new(0.5, i%2==0 and 10 or -10, 0.5, 0)}):Play()
        task.wait(0.04)
    end
    KCard.Position = orig
end

local function tryKey()
    local val = KInput.Text:lower():gsub("%s+","")
    if val == VALID_KEY then
        KStatus.TextColor3 = Color3.fromRGB(80,255,140)
        KStatus.Text = "✓ Access granted. Loading..."
        KInputStroke.Color = Color3.fromRGB(80,255,140)
        task.wait(0.6)
        TweenService:Create(KCard, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In), 
            {Position = UDim2.new(0.5,0,0.35,0)}):Play()
        TweenService:Create(Overlay, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()
        task.wait(0.4)
        KGui:Destroy()
        keyUnlocked = true
    else
        KStatus.Text = "✗ Wrong key. Join Discord for the key!"
        KStatus.TextColor3 = Color3.fromRGB(255,80,80)
        KInputStroke.Color = Color3.fromRGB(255,80,80)
        task.spawn(shakeCard)
    end
end

KBtn.MouseButton1Click:Connect(tryKey)
KInput.FocusLost:Connect(function(enter) if enter then tryKey() end end)

