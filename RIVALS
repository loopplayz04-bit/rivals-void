        nameL.Size = UDim2.new(1,0,0.5,0)
        nameL.BackgroundTransparency = 1
        nameL.TextColor3 = Color3.fromRGB(255,255,255)
        nameL.TextStrokeTransparency = 0
        nameL.TextStrokeColor3 = Color3.fromRGB(0,0,0)
        nameL.TextSize = 14
        nameL.Font = Enum.Font.GothamBold
        nameL.Text = player.Name
        nameL.Parent = bb
        
        local infoL = Instance.new("TextLabel")
        infoL.Name = "InfoL"
        infoL.Size = UDim2.new(1,0,0.5,0)
        infoL.Position = UDim2.new(0,0,0.5,0)
        infoL.BackgroundTransparency = 1
        infoL.TextColor3 = Color3.fromRGB(180,255,180)
        infoL.TextStrokeTransparency = 0
        infoL.TextStrokeColor3 = Color3.fromRGB(0,0,0)
        infoL.TextSize = 12
        infoL.Font = Enum.Font.Gotham
        infoL.Text = ""
        infoL.Parent = bb
        
        if gethui then 
            bb.Parent = gethui()
        elseif syn and syn.protect_gui then 
            bb.Parent = game.CoreGui
        else 
            bb.Parent = game.CoreGui 
        end
        
        ESPObjects[player] = { hl = hl, bb = bb }
    end
    
    if player.Character then onChar(player.Character) end
    player.CharacterAdded:Connect(onChar)
end

RunService.RenderStepped:Connect(function()
    for player, obj in pairs(ESPObjects) do
        local alive = isAlive(player)
        local show  = CFG.ESPEnabled and alive
        
        if obj.hl then
            obj.hl.Enabled = show and CFG.ShowBoxes
        end
        
        if obj.bb then
            obj.bb.Enabled = show
            if show then
                local c     = player.Character
                local lc    = LocalPlayer.Character
                if c and lc then
                    local r  = c:FindFirstChild("HumanoidRootPart")
                    local lr = lc:FindFirstChild("HumanoidRootPart")
                    local h  = c:FindFirstChildOfClass("Humanoid")
                    if r and lr then
                        local dist = math.floor((r.Position - lr.Position).Magnitude)
                        if dist > CFG.MaxDistance then
                            obj.bb.Enabled = false
                        else
                            local nL = obj.bb:FindFirstChild("NameL")
                            local iL = obj.bb:FindFirstChild("InfoL")
                            if nL then nL.Visible = CFG.ShowNames end
                            if iL then
                                local parts = {}
                                if CFG.ShowDistance then parts[#parts+1] = dist.."m" end
                                if CFG.ShowHealth and h then
                                    parts[#parts+1] = "HP "..math.floor(h.Health).."/"..math.floor(h.MaxHealth)
                                end
                                iL.Visible = #parts > 0
                                iL.Text = table.concat(parts, "  |  ")
                            end
                        end
                    end
                end
            end
        end
    end
end)

